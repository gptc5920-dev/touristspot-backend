APP_ENV=development
APP_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
FRONTEND_URL=http://localhost:5173
REMEMBER_ME_SECONDS=1209600
PASSWORD_RESET_TIMEOUT=3600

# XAMPP local development (MariaDB 10.4).
MYSQL_DATABASE=tourist
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=0
MYSQL_ALLOW_LEGACY_MARIADB=true

# Development prints reset emails to the API terminal. Configure SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Travel Osmena <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
